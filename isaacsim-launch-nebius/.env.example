# Copy to .env and edit:  cp .env.example .env
INSTANCE_NAME=isaac-sim
ISAAC_SIM_VERSION=6.0.1
PHYSICS_BACKEND=physx          # physx | newton
SSH_KEY=~/.ssh/id_ed25519      # public key = ${SSH_KEY}.pub  (ssh-keygen -t ed25519 if missing)
ALLOW_CIDR=auto                # auto = your current public IP /32.  0.0.0.0/0 opens the box to everyone.

# ---------- Nebius ----------
# Your project id:  nebius iam project list --parent-id <tenant-id>
# Blank = parent-id from ~/.nebius/config.yaml (set by `nebius init`).
NEBIUS_PROJECT_ID=
# us-central1: RTX PRO 6000 Blackwell (96 GB), ~$1.80/hr   <-- verified working
NEBIUS_PLATFORM=gpu-rtx6000
NEBIUS_PRESET=1gpu-24vcpu-218gb
NEBIUS_IMAGE_FAMILY=ubuntu24.04-cuda13.0
NEBIUS_DISK_GIB=512
NEBIUS_SUBNET_ID=              # blank = first subnet in the project

# eu-north1 alternative: L40S, ~$1.55/hr
#NEBIUS_PLATFORM=gpu-l40s-a
#NEBIUS_PRESET=1gpu-24vcpu-96gb

